LEXERMAP = {'emacs-lisp': 'common-lisp',
            'scheme': 'common-lisp',
            'nxml': 'xml',
            'c++': 'cpp'}

URI = 'https://paste.in.ua/'
mode_re = re.compile(r'-\*-.*mode: (?P<mode>[\w\.\-]+).*-\*-', re.I)

def findlexer(fn, default=None):
    fn = os.path.basename(fn)
    for pat, lexer in EXTMAP.items():
        if fnmatch.fnmatch(fn, pat):
            return lexer
    return default

def guess_lexer(data, default):
    lines = data.splitlines()
    if not lines:
        print('abort: no data')
        sys.exit(1)
    line = lines[0]
    if line.startswith('#!'):
        parts = line.split()
        exe = os.path.basename(parts[0][2:])
        return parts[1] if exe == 'env' and len(parts) > 1 else exe
    for line in lines[:2]:
        m = mode_re.search(line)
        if m:
            mode = m.group('mode')
            return LEXERMAP.get(mode, mode)
    prob = False
    for line in lines:
        if line.startswith('--- '):
            prob = True
        elif line.startswith('+++ ') and prob:
            return 'diff'
        else:
            prob = False
    return default

def print_lexers():
    print('\n'.join(sorted(LEXERS)))
    sys.exit()

def paste(data, lexer):
    post = urllib.parse.urlencode({'data': data, 'lexer': lexer}).encode()
    req = urllib.request.Request(URI, data=post)
    with urllib.request.urlopen(req) as r:
        return r.geturl()

def result(url):
    print(url)
    for util in ['xclip', 'pbcopy']:
        if os.system(f'which {util} > /dev/null 2>&1') == 0:
            os.system(f'printf {url} | {util}')
            print(f'url copied to clipboard using {util}')

def main():
    p = argparse.ArgumentParser()
    p.add_argument('file', nargs='?')
    p.add_argument('-t', '--type', default='')
    p.add_argument('--types', action='store_true')
    args = p.parse_args()

    if args.types:
        print_lexers()

    if not args.file:
        if sys.stdin.isatty():
            p.print_help()
            sys.exit(1)
        data = sys.stdin.read()
        lexer = args.type
    else:
        with open(args.file, 'r') as f:
            data = f.read()
        lexer = args.type or findlexer(args.file)

    lexer = lexer or guess_lexer(data, 'text')

    if lexer not in LEXERS:
        print(f'abort: {lexer} is not a valid file type')
        sys.exit(1)

    result(paste(data, lexer))

if __name__ == '__main__':
    main()
